  "startCrop": "wide",
  "bubbles": [
    {
      "t0": 0.8,
      "t1": 44,
      "text": "Mercredi matin. Le message est là.",
      "gloss": "星期三早上。那封消息还在那儿。",
      "anchor": "narrator",
      "kind": "narrator"
    },
    {
      "t0": 90.8,
      "t1": 134,
      "text": "Bon. Je lis le message.",
      "gloss": "好。我来读消息。",
      "actor": "camille",
      "kind": "camille"
    },
    {
      "t0": 135.8,
      "t1": 194,
      "text": "Sur l’écran, il y a le message.",
      "gloss": "屏幕上是那封消息。",
      "anchor": "narrator",
      "kind": "narrator"
    },
    {
      "t0": 195.8,
      "t1": 244,
      "text": "Bonjour à vous trois. J’espère que tout va bien.",
      "gloss": "你们三位好。希望一切都好。",
      "anchor": "martin",
      "kind": "screen"
    },
    {
      "t0": 245.8,
      "t1": 289,
      "text": "Une photo de la plante, s’il vous plaît.",
      "gloss": "请拍一张植物的照片。",
      "anchor": "martin",
      "kind": "screen"
    },
    {
      "t0": 290.8,
      "t1": 334,
      "text": "De la plante. Pas du chat.",
      "gloss": "是植物。不是猫。",
      "anchor": "martin",
      "kind": "screen"
    },
    {
      "t0": 380.8,
      "t1": 429,
      "text": "Je reviendrai à la fin du mois. Nous parlerons de la plante.",
      "gloss": "我月底会回来。我们会聊聊这盆植物。",
      "anchor": "martin",
      "kind": "screen"
    },
    {
      "t0": 485.8,
      "t1": 529,
      "text": "C’est tout ? C’est un petit message.",
      "gloss": "就这些？好短的消息。",
      "actor": "noe",
      "kind": "noe"
    },
    {
      "t0": 530.8,
      "t1": 574,
      "text": "Un petit message. Un grand problème.",
      "gloss": "消息很短。问题很大。",
      "actor": "camille",
      "kind": "camille"
    },
    {
      "t0": 575.8,
      "t1": 619,
      "text": "Écoute. Madame Martin voudrait une photo de quoi ?",
      "gloss": "听。Martin 太太想要什么的照片？",
      "anchor": "narrator",
      "kind": "narrator"
    },
    {
      "t0": 665.8,
      "t1": 709,
      "text": "Il n’y a plus de lait.",
      "gloss": "牛奶没了。",
      "actor": "noe",
      "kind": "noe"
    },
    {
      "t0": 710.8,
      "t1": 754,
      "text": "Règle numéro trois : le lait, ça va dans le frigo. Pas dans ton ventre.",
      "gloss": "第三条：牛奶放冰箱里。不是放你肚子里。",
      "actor": "camille",
      "kind": "camille"
    },
    {
      "t0": 755.8,
      "t1": 799,
      "text": "J’ai faim ! Et pas de lait.",
      "gloss": "我饿了！还没有牛奶。",
      "actor": "noe",
      "kind": "noe"
    },
    {
      "t0": 800.8,
      "t1": 844,
      "text": "Tu veux du café ? Sans lait.",
      "gloss": "你要喝咖啡吗？不加奶的。",
      "actor": "camille",
      "kind": "camille"
    },
    {
      "t0": 900.8,
      "t1": 944,
      "text": "Plus tard, à l’appartement. Camille regarde la photo. Derrière la plante… une queue orange.",
      "gloss": "后来，回到家里，Camille 看着照片。植物后面……有一条橘色的尾巴。",
      "anchor": "narrator",
      "kind": "narrator"
    },
    {
      "t0": 945.8,
      "t1": 989,
      "text": "Noé. C’est quoi, ça ?",
      "gloss": "Noé。这是什么？",
      "actor": "camille",
      "kind": "camille"
    },
    {
      "t0": 990.8,
      "t1": 1034,
      "text": "Ce n’est pas moi !",
      "gloss": "不是我！",
      "actor": "noe",
      "kind": "noe"
    },
    {
      "t0": 1080.8,
      "t1": 1124,
      "text": "Une photo de la plante. Pas du chat. Mais le chat est sur la photo.",
      "gloss": "一张植物的照片。不是猫的。可是猫在照片里。",
      "anchor": "narrator",
      "kind": "narrator"
    }
  ],
